# Copy to .env (development) or /etc/gssl/gssl.env (production) and fill in.
# Never commit the filled-in file.

# --- Required in production -------------------------------------------------

# A long random string, unique per server. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this site answers on.
DJANGO_ALLOWED_HOSTS=greensparksolutions.com,www.greensparksolutions.com

# Canonical https:// origin, used for canonical links, the sitemap and share
# cards. The site refuses to start without it.
DJANGO_SITE_URL=https://greensparksolutions.com

# --- Storage ----------------------------------------------------------------

# The SQLite database: admin login, sessions and every contact-form enquiry.
# Keep it outside the code checkout and back it up.
DJANGO_DB_PATH=/srv/gssl/data/db.sqlite3

# Where collectstatic writes; nginx serves /static/ from here.
DJANGO_STATIC_ROOT=/srv/gssl/static

# --- Admin ------------------------------------------------------------------

# Path of the Django admin. Something less guessable than admin/ is better.
DJANGO_ADMIN_URL=admin/

# --- The console (the admin panel staff use) --------------------------------

# Path of the console. Like the admin, something less guessable is better.
DJANGO_CONSOLE_URL=office/

# Signed out after this long without a request (seconds). Content editing
# happens on shared office machines, so the default is deliberately short.
DJANGO_CONSOLE_IDLE_SECONDS=7200

# Failed sign-ins per address+visitor before the form stops answering, and
# for how long (seconds).
DJANGO_CONSOLE_LOGIN_MAX_ATTEMPTS=8
DJANGO_CONSOLE_LOGIN_LOCKOUT_SECONDS=900

# Rows per page in every console list.
DJANGO_CONSOLE_PER_PAGE=25

# Server errors are emailed here once email is configured.
# DJANGO_ADMINS="Web team <web@greensparksolutions.com>"

# --- Email (contact form) ---------------------------------------------------
# Leave DJANGO_EMAIL_HOST empty and enquiries are still saved and listed in the
# admin; they are simply not emailed until it is set.

DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL="Green Spark website <info@greensparksolutions.com>"
DJANGO_ENQUIRY_RECIPIENTS=info@greensparksolutions.com

# --- HTTPS ------------------------------------------------------------------

# 1 when nginx / Apache / a load balancer terminates TLS (the normal set-up).
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1

# HSTS. If any subdomain still serves plain HTTP (webmail, cPanel, an old
# site), set INCLUDE_SUBDOMAINS to 0 BEFORE the first deploy: browsers
# remember it for a year.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
